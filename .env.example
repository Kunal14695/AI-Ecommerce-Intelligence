# Environment Variables Configuration
ENVIRONMENT=development
PORT=8000
SECRET_KEY=poornima_ai_ecommerce_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Uses SQLite for local dev if empty/sqlite, or PostgreSQL URL
DATABASE_URL=sqlite:///./ecommerce.db
# Example Postgres: postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db

# Nominatim OSM Geocoding Proxy
NOMINATIM_USER_AGENT=PoornimaAICommerceApp/1.0 (contact@poornima.edu.in)
NOMINATIM_RATE_LIMIT_DELAY=1.0

# Serviceable PIN codes default (comma-separated or handled via DB)
DEFAULT_SERVICEABLE_PINS=302022,302029,302020,302017,302001,110001,400001,560001

# Feature flags
ENABLE_LLM_REPHRASE=false
